// Opening animation in Vanta's pixel style: the pixel V builds up in
// steps, the name types in, and a block bar fills before the splash fades.
// About 1.2 s; click to skip; skipped with "Reduce motion".

import { Theme, Motion } from "theme.slint";

export component Splash inherits Rectangle {
    private property <float> t: 0;
    private property <bool> skipped: false;
    animate t { duration: 1200ms; easing: linear; }
    init => { root.t = 1; }

    pure function clamp01(x: float) -> float { return max(0, min(1, x)); }
    // Quantised progress gives the stepped, pixel feel.
    pure function steps(x: float, n: int) -> float { return floor(root.clamp01(x) * n) / n; }

    private property <float> mark: root.steps(root.t / 0.4, 12);
    private property <float> bar: root.steps((root.t - 0.3) / 0.45, 10);
    private property <float> fade: root.steps((root.t - 0.8) / 0.2, 4);

    visible: !Motion.reduce && !root.skipped && root.t < 1;
    background: Theme.bg;
    opacity: 1 - root.fade;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.skipped = true; }
    }

    // Pixel V, revealed bottom-up in 12 steps.
    reveal := Rectangle {
        width: 96px;
        height: 96px * root.mark;
        x: (parent.width - self.width) / 2;
        y: (parent.height - 96px) / 2 - 40px + (96px - self.height);
        clip: true;
        Image {
            y: reveal.height - 96px;
            width: 96px;
            height: 96px;
            source: @image-url("icons/logo-px24.png");
            image-rendering: pixelated;
            colorize: Theme.text;
        }
    }

    // Name, typed letter by letter.
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 + 28px;
        width: self.preferred-width;
        spacing: 6px;
        for ch[i] in ["V", "A", "N", "T", "A"]: Text {
            text: ch;
            color: Theme.text;
            font-family: "Pixelify Sans";
            font-size: 28px;
            font-weight: 600;
            opacity: root.t > 0.25 + i * 0.07 ? 1 : 0;
        }
    }

    // Block loading bar.
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 + 82px;
        width: self.preferred-width;
        spacing: 4px;
        for i in 10: Rectangle {
            width: 12px;
            height: 12px;
            background: i < root.bar * 10 ? Theme.accent : Theme.surface-3;
        }
    }
}
