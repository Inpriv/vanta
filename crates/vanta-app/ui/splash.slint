// Opening animation in Vanta's pixel style: the pixel V is drawn block by
// block like a pen stroke (a bright accent tip that settles to white) while
// the name types in and a block bar fills in step, then the splash fades.
// About 1.3 s; click to skip; skipped with "Reduce motion".

import { Theme, Motion } from "theme.slint";
import { SplashPixels } from "splash_pixels.slint";

export component Splash inherits Rectangle {
    private property <float> t: 0;
    private property <bool> skipped: false;
    animate t { duration: 1300ms; easing: linear; }
    init => { root.t = 1; }

    pure function clamp01(x: float) -> float { return max(0, min(1, x)); }
    // Quantised progress gives the stepped, pixel feel.
    pure function steps(x: float, n: int) -> float { return floor(root.clamp01(x) * n) / n; }

    // Logo: 24 x 24 blocks of 4 px.
    private property <length> block: 4px;
    private property <length> logo-x: round((root.width - 24 * root.block) / 2 / 1px) * 1px;
    private property <length> logo-y: round((root.height - 24 * root.block) / 2 / 1px) * 1px - 40px;
    // Each block starts at its place along the stroke and settles in 90 ms.
    private property <float> draw-start: 0.03;
    private property <float> draw-span: 0.42;
    private property <float> settle: 0.07;

    // Drawing progress (0..1). The bar and the name follow it, so all three
    // finish together.
    private property <float> progress: root.clamp01((root.t - root.draw-start) / (root.draw-span + root.settle));
    private property <float> bar: root.steps(root.progress, 10);
    private property <float> fade: root.steps((root.t - 0.85) / 0.15, 4);

    visible: !Motion.reduce && !root.skipped && root.t < 1;
    background: Theme.bg;
    opacity: 1 - root.fade;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.skipped = true; }
    }

    // The V, drawn along the pen stroke.
    for b in SplashPixels.blocks: Rectangle {
        private property <float> local: root.clamp01((root.t - root.draw-start - b.d * root.draw-span) / root.settle);
        // A just-placed block pops in a little larger, then snaps to size.
        private property <length> size: self.local < 0.35 ? root.block + 2px : root.block;
        visible: self.local > 0;
        x: root.logo-x + b.x * root.block - (self.size - root.block) / 2;
        y: root.logo-y + b.y * root.block - (self.size - root.block) / 2;
        width: self.size;
        height: self.size;
        background: self.local < 0.35 ? Theme.accent.brighter(0.35) : self.local < 1 ? Theme.accent : Theme.text;
    }

    // Name, typed letter by letter.
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 + 28px;
        width: self.preferred-width;
        spacing: 6px;
        for ch[i] in ["V", "A", "N", "T", "A"]: Text {
            text: ch;
            color: Theme.text;
            font-family: "Pixelify Sans";
            font-size: 28px;
            font-weight: 600;
            // One letter per fifth of the drawing.
            opacity: root.progress >= (i + 1) / 5 - 0.001 ? 1 : 0;
        }
    }

    // Block loading bar.
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 + 82px;
        width: self.preferred-width;
        spacing: 4px;
        for i in 10: Rectangle {
            width: 12px;
            height: 12px;
            background: i < root.bar * 10 ? Theme.accent : Theme.surface-3;
        }
    }
}
